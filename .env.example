# Copy to .env and fill in. .env is ignored by git; never commit real tokens.

# Where content comes from: "storyblok", or "mock" for the files in src/mocks
CONTENT_SOURCE=mock

# Storyblok space (Settings > General) and region: eu, us, ap or ca
STORYBLOK_SPACE_ID=
STORYBLOK_REGION=eu

# Read-only token used by the website (Settings > Access tokens, access level "Preview")
STORYBLOK_DELIVERY_API_TOKEN=

# Only for npm run storyblok:push and storyblok:seed (My account > Account settings > Personal access token).
# Keep it out of Cloudflare: the website never needs it
STORYBLOK_PERSONAL_ACCESS_TOKEN=

# Optional: "draft" shows unpublished changes (for a preview build); default is drafts in dev, published otherwise
# STORYBLOK_VERSION=draft
