---
import SiteLayout from '@layouts/SiteLayout.astro'
import SectionHeader from '@components/composite/SectionHeader/SectionHeader.astro'
import type { ContactPage } from '@app-types/content'
import type { SiteSettings } from '@app-types/content'
import { editableAttrs } from '@lib/storyblok/editable'

// The contact page. Used by /contact and by the Visual Editor preview
interface Props {
    contact: ContactPage
    settings?: SiteSettings
}

const { contact: data, settings } = Astro.props

const pageTitle = data?.title ?? 'Contact'
const pageDescription = data?.description ?? ''
const heading = data?.heading ?? 'Get in Touch'
const subheading = data?.subheading ?? "For research inquiries, speaking engagements, or general correspondence — send a message and we'll respond as soon as possible."
const label = data?.label ?? 'Contact'
---

<SiteLayout title={pageTitle} description={pageDescription} settings={settings}>
    <main id="main" {...editableAttrs(data._editable)}>
        <section class="contact-page">
            <div class="contact-page__container">
                <div class="contact-page__header">
                    <SectionHeader label={label} heading={heading} align="center" as="h1" />
                    <p class="contact-page__subheading">{subheading}</p>
                </div>

                {/* Netlify Forms handles submissions: it finds this form at deploy time and redirects to the
                    thank-you page on success. The hidden bot-field catches spam bots that fill in every input */}
                <form
                    class="contact-form"
                    name="contact"
                    method="POST"
                    action="/contact/thanks"
                    data-netlify="true"
                    netlify-honeypot="bot-field"
                    data-contact-form
                >
                    <input type="hidden" name="form-name" value="contact" />
                    <p class="contact-form__trap" aria-hidden="true">
                        <label>Leave this empty <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
                    </p>

                    <div class="contact-form__row">
                        <div class="contact-form__field">
                            <label class="contact-form__label" for="name">Name</label>
                            <input class="contact-form__input" type="text" id="name" name="name" autocomplete="name" required aria-describedby="name-error" />
                            <p class="contact-form__error" id="name-error" data-message="Please enter your name." hidden></p>
                        </div>
                        <div class="contact-form__field">
                            <label class="contact-form__label" for="email">Email</label>
                            <input class="contact-form__input" type="email" id="email" name="email" autocomplete="email" required aria-describedby="email-error" />
                            <p class="contact-form__error" id="email-error" data-message="Please enter an email address, like name@example.com, so we can reply." hidden></p>
                        </div>
                    </div>

                    <div class="contact-form__field">
                        <label class="contact-form__label" for="message">Message</label>
                        <textarea class="contact-form__textarea" id="message" name="message" rows="6" required aria-describedby="message-error"></textarea>
                        <p class="contact-form__error" id="message-error" data-message="Please write a message." hidden></p>
                    </div>

                    <div class="contact-form__footer">
                        <button class="contact-form__submit" type="submit">
                            Send Message
                            <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M5 12h14M12 5l7 7-7 7" />
                            </svg>
                        </button>
                    </div>
                </form>

                {data.email && (
                    <p class="contact-page__alt">
                        Prefer email? Write to <a href={`mailto:${data.email}`}>{data.email}</a>
                    </p>
                )}
            </div>
        </section>
    </main>
</SiteLayout>

<script>
    // Our own messages instead of the browser's pop-ups, which are small and vanish quickly.
    // Without JavaScript the browser's built-in checks still apply, because noValidate is only set here
    const form = document.querySelector<HTMLFormElement>('[data-contact-form]')
    if (form) {
        form.noValidate = true
        const fields = Array.from(form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('input[required], textarea[required]'))

        const check = (field: HTMLInputElement | HTMLTextAreaElement) => {
            const error = document.getElementById(`${field.id}-error`)
            const valid = field.value.trim() !== '' && field.checkValidity()
            field.setAttribute('aria-invalid', String(!valid))
            if (error) {
                error.textContent = valid ? '' : (error.dataset.message ?? '')
                error.hidden = valid
            }
            return valid
        }

        form.addEventListener('submit', (event) => {
            const invalid = fields.filter((field) => !check(field))
            if (invalid.length) {
                event.preventDefault()
                invalid[0].focus()
            }
        })

        // Once a field has shown an error, re-check it as the visitor types so the message clears
        fields.forEach((field) =>
            field.addEventListener('input', () => {
                if (field.getAttribute('aria-invalid') === 'true') check(field)
            })
        )
    }
</script>

<style lang="scss">
    @use '@tokens/mixins' as *;

    .contact-page {
        background: var(--color-bg);
        min-height: 100vh;

        &__container {
            max-width: var(--container-md);
            margin: 0 auto;
            padding: var(--page-top) var(--gutter) var(--section-y);
        }

        &__header {
            margin-bottom: var(--space-8);
        }

        &__alt {
            margin-top: var(--space-6);
            text-align: center;
            font-family: var(--font-ui);
            font-size: var(--text-sm);
            color: var(--color-text-secondary);

            a {
                color: var(--color-text-strong);
                text-decoration: underline;
                text-underline-offset: 0.2em;
            }
        }

        &__subheading {
            font-family: var(--font-body);
            font-size: var(--text-md);
            color: var(--color-text-secondary);
            line-height: var(--leading-relaxed);
            text-align: center;
            max-width: var(--container-sm);
            margin: var(--space-5) auto 0;
        }
    }

    .contact-form {
        display: flex;
        flex-direction: column;
        gap: var(--space-5);

        &__row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: var(--space-5);

            @media (max-width: $bp-sm) {
                grid-template-columns: 1fr;
            }
        }

        &__field {
            display: flex;
            flex-direction: column;
            gap: var(--space-2);
        }

        &__label {
            font-family: var(--font-ui);
            font-size: var(--text-xs);
            letter-spacing: var(--tracking-wider);
            text-transform: uppercase;
            color: var(--color-text-secondary);
            font-weight: var(--weight-semibold);
        }

        &__input,
        &__textarea {
            font-family: var(--font-body);
            font-size: var(--text-md);
            color: var(--color-text);
            background: var(--color-surface);
            border: var(--border-thin) solid var(--color-border-strong);
            padding: var(--space-3) var(--space-4);
            border-radius: var(--radius-sm);
            width: 100%;
            transition: border-color var(--duration-fast) var(--ease-standard);

            &::placeholder {
                color: var(--color-text-secondary);
                opacity: 1;
            }

            &:focus {
                border-color: var(--color-accent);
            }
        }

        &__input[aria-invalid='true'],
        &__textarea[aria-invalid='true'] {
            border-color: var(--burgundy);
            // A second pixel drawn inside the border, so the field doesn't change size
            box-shadow: inset 0 0 0 1px var(--burgundy);
        }

        &__error {
            font-family: var(--font-ui);
            font-size: var(--text-sm);
            color: var(--burgundy);
        }

        // Off-screen rather than display: none, which some bots detect and skip
        &__trap {
            position: absolute;
            left: -9999px;
            width: 1px;
            height: 1px;
            overflow: hidden;
        }

        &__textarea {
            resize: vertical;
            min-height: 160px;
        }

        &__footer {
            display: flex;
            justify-content: flex-end;
            padding-top: var(--space-2);
        }

        &__submit {
            display: inline-flex;
            align-items: center;
            gap: var(--space-3);
            font-family: var(--font-ui);
            font-size: var(--text-xs);
            font-weight: var(--weight-semibold);
            letter-spacing: var(--tracking-wider);
            text-transform: uppercase;
            color: var(--color-text-on-dark);
            background: var(--color-surface-dark);
            border: var(--border-thick) solid var(--color-surface-dark);
            padding: var(--space-4) var(--space-6);
            cursor: pointer;
            min-height: var(--tap-target);
            transition: var(--transition-colors);

            svg {
                width: var(--icon-md);
                height: var(--icon-md);
                transition: transform var(--transition);
            }

            &:hover {
                background: var(--color-surface-dark-hover);
                border-color: var(--color-surface-dark-hover);

                svg {
                    transform: translateX(var(--space-1));
                }
            }
        }
    }
</style>
