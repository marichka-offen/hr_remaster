---
import RichText from '@components/base/RichText/RichText.astro'
import type { RichText as RichTextType } from '@app-types/content'
import './PhilosophyBlock.scss'

interface Props {
    quote: string
    body?: RichTextType
}

const { quote, body } = Astro.props
---

<section class="philosophy">
    <div class="philosophy__container">
        <div class="philosophy__quote-wrap">
            <span class="philosophy__mark">&ldquo;</span>
            <blockquote class="philosophy__quote">{quote}</blockquote>
        </div>
        {body?.length ? (
            <div class="philosophy__body">
                <RichText blocks={body} />
            </div>
        ) : null}
    </div>
</section>
