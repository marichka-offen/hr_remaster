---
import MobileNav from '@components/composite/MobileNav/MobileNav'
import Logo from '@components/composite/Logo/Logo.astro'
import NavLink from '@components/composite/NavLink/NavLink.astro'
import './Header.scss'

interface NavLinkItem {
    label: string
    href: string
}

interface Props {
    logoTitle?: string
    logoSubtitle?: string
    navLinks: NavLinkItem[]
}

const { logoTitle, logoSubtitle, navLinks } = Astro.props

// "/articles/" and "/articles" are the same page
const normalise = (path: string) => (path.length > 1 ? path.replace(/\/+$/, '') : path)
const currentPath = normalise(Astro.url.pathname)

// A link is active on its own page and on every page below it, so Articles stays lit while reading
// an article. Home only matches the home page itself
const isActive = (href: string) => {
    const target = normalise(href)
    return target === '/' ? currentPath === '/' : currentPath === target || currentPath.startsWith(`${target}/`)
}
const activeHref = navLinks.find((link) => isActive(link.href))?.href
---

<header class='header'>
    <div class='header__inner'>
        <div class='header__logo'>
            <Logo title={logoTitle} subtitle={logoSubtitle} size="lg" tone="light" />
        </div>
        <nav class='header__nav' aria-label='Main'>
            {navLinks.map((link) => (
                <NavLink
                    href={link.href}
                    label={link.label}
                    active={link.href === activeHref}
                    exact={normalise(link.href) === currentPath}
                />
            ))}
            {/* Search button returns with Pagefind in phase 8 */}
        </nav>
        <MobileNav client:load navLinks={navLinks} activeHref={activeHref} currentPath={currentPath} />
    </div>
</header>

<script>
    // Slim header once the page has scrolled. The attribute drives --header-offset in tokens.css,
    // which the header, reading-progress bar and contents list all follow
    const root = document.documentElement
    let frame = 0
    const update = () => {
        frame = 0
        root.toggleAttribute('data-scrolled', window.scrollY > 24)
    }
    update()
    window.addEventListener('scroll', () => {
        if (!frame) frame = requestAnimationFrame(update)
    }, { passive: true })
</script>
