---
// One article given prominence: a burgundy card with the article's image (or its years on a period band)
import SectionHeading from '@components/composite/SectionHeading/SectionHeading.astro'
import { cardMeta, eraColor, years } from '@lib/period'
import './FeaturedArticle.scss'
import type { ArticleMeta } from '@app-types/article'

interface Props {
    label?: string
    heading?: string
    article: ArticleMeta
}

const { heading, article } = Astro.props
const meta = cardMeta(article)
const span = years(article)
---

<section class="featured">
    <div class="featured__container">
        <SectionHeading heading={heading} />
        <article class="featured__card">
            <div class="featured__media" style={`--band: ${eraColor(article.startYear)}`}>
                {article.imageUrl ? (
                    <img src={article.imageUrl} alt={article.imageAlt ?? ''} class="featured__image" />
                ) : (
                    <span class="featured__years" aria-hidden="true">{span}</span>
                )}
            </div>
            <div class="featured__body">
                <p class="featured__topic">{article.category}{span && ` · ${span}`}</p>
                <h3 class="featured__title"><a href={`/articles/${article.slug}`}>{article.title}</a></h3>
                {article.excerpt && <p class="featured__excerpt">{article.excerpt}</p>}
                {meta && <p class="featured__meta">{meta}</p>}
                <a class="featured__link" href={`/articles/${article.slug}`} aria-hidden="true" tabindex="-1">Read the article</a>
            </div>
        </article>
    </div>
</section>
