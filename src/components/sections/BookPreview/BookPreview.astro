---
import Button from '@components/base/Button/Button'
import BookCover from '@components/composite/BookCover/BookCover.astro'
import './BookPreview.scss'
import type { CTA } from '@app-types/cta'

interface Props {
    label?: string
    coverLabel?: string
    title: string
    subtitle?: string
    coverImageUrl?: string
    coverImageAlt?: string
    description?: string
    cta?: CTA
}

const { label, coverLabel, title, subtitle, coverImageUrl, coverImageAlt, description, cta } = Astro.props
---

<section class="book-preview">
    <div class="book-preview__container">
        <div class="book-preview__inner">
            <div class="book-preview__cover">
                <BookCover
                    title={title}
                    subtitle={subtitle}
                    label={coverLabel}
                    imageUrl={coverImageUrl}
                    imageAlt={coverImageAlt}
                />
            </div>
            <div class="book-preview__info">
                {label && <div class="book-preview__info-label">{label}</div>}
                <h2>{title}</h2>
                {description && <p>{description}</p>}
                {cta?.text && (
                    <Button
                        variant='solid-gold'
                        onTone='dark'
                        href={cta.link ?? '/books'}
                        text={cta.text}
                        openInNewTab={cta.openInNewTab}
                    />
                )}
            </div>
        </div>
    </div>
</section>
