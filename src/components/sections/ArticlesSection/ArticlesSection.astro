---
// A selection of articles with an optional topic filter; the link to the full archive sits beside the heading
import ArticleCardGrid from '@components/composite/ArticleCardGrid/ArticleCardGrid'
import SectionHeading from '@components/composite/SectionHeading/SectionHeading.astro'
import './ArticlesSection.scss'
import type { ArticleMeta } from '@app-types/article'
import type { CTA } from '@app-types/cta'

interface Props {
    label?: string
    heading?: string
    articles: ArticleMeta[]
    showCategoryFilter?: boolean
    cta?: CTA
}

const { heading, articles, showCategoryFilter, cta } = Astro.props
---

<section id="articles" class="articles">
    <div class="articles__container">
        <SectionHeading heading={heading} link={cta} />
        <ArticleCardGrid client:load articles={articles} showCategoryFilter={showCategoryFilter} />
    </div>
</section>
