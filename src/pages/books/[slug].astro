---
import SiteLayout from '@layouts/SiteLayout.astro'
import Button from '@components/base/Button/Button'
import RichText from '@components/base/RichText/RichText.astro'
import BookCover from '@components/composite/BookCover/BookCover.astro'
import BookPreview from '@components/sections/BookPreview/BookPreview.astro'
import { getBook, getBooks } from '@lib/content'

export async function getStaticPaths() {
    const books = await getBooks()
    return books.map((book) => ({ params: { slug: book.slug } }))
}

const book = await getBook(Astro.params.slug)

if (!book) return Astro.redirect('/books')

const otherBooks = (await getBooks()).filter((other) => other.slug !== book.slug)
const details = book.details ?? []
const previewPages = book.previewPages ?? []
const hasSidebar = details.length > 0 || previewPages.length > 0
---

<SiteLayout title={book.title} description={book.excerpt ?? ''}>
    <main id="main">
        <section class="book-hero">
            <div class="book-hero__inner">
                <div class="book-hero__cover">
                    <BookCover
                        title={book.title}
                        subtitle={book.subtitle}
                        author={book.author}
                        imageUrl={book.coverImageUrl}
                        imageAlt={book.coverImageAlt}
                        size="lg"
                    />
                </div>

                <div class="book-hero__text">
                    {book.status && <p class="book-hero__status">{book.status}</p>}
                    <h1 class="book-hero__title">{book.title}</h1>
                    {book.subtitle && <p class="book-hero__subtitle">{book.subtitle}</p>}
                    <div class="book-hero__divider" aria-hidden="true"></div>
                    {book.excerpt && <p class="book-hero__excerpt">{book.excerpt}</p>}

                    {(book.cta || book.secondaryCta) && (
                        <div class="book-hero__actions">
                            {book.cta && (
                                <Button variant="solid-gold" onTone="dark" href={book.cta.link} text={book.cta.text} openInNewTab={book.cta.openInNewTab} />
                            )}
                            {book.secondaryCta && (
                                <Button variant="outline-gold" onTone="dark" icon={false} href={book.secondaryCta.link} text={book.secondaryCta.text} openInNewTab={book.secondaryCta.openInNewTab} />
                            )}
                        </div>
                    )}
                </div>
            </div>
        </section>

        {(book.description?.length || hasSidebar) && (
            <section class="book-about">
                <div class={`book-about__inner${hasSidebar ? ' book-about__inner--sidebar' : ''}`}>
                    {book.description?.length ? (
                        <div class="book-about__text">
                            <h2 class="book-about__heading">About the Book</h2>
                            <div class="prose">
                                <RichText blocks={book.description} />
                            </div>
                        </div>
                    ) : null}

                    {hasSidebar && (
                        <aside class="book-about__sidebar">
                            {details.length > 0 && (
                                <div class="book-about__panel">
                                    <h2 class="book-about__panel-title">Book Details</h2>
                                    <dl class="book-about__details">
                                        {details.map((detail) => (
                                            <div class="book-about__detail">
                                                <dt>{detail.label}</dt>
                                                <dd>{detail.value}</dd>
                                            </div>
                                        ))}
                                    </dl>
                                </div>
                            )}

                            {previewPages.length > 0 && (
                                <div class="book-about__panel">
                                    <h2 class="book-about__panel-title">Preview Pages</h2>
                                    <ul class="book-about__previews">
                                        {previewPages.map((page) => (
                                            <li>
                                                {page.src ? (
                                                    <img src={page.src} alt={page.alt} loading="lazy" />
                                                ) : (
                                                    <div class="book-about__preview-placeholder" role="img" aria-label={`Preview page to come: ${page.alt}`}>
                                                        {page.alt}
                                                    </div>
                                                )}
                                            </li>
                                        ))}
                                    </ul>
                                </div>
                            )}
                        </aside>
                    )}
                </div>
            </section>
        )}

        {otherBooks.map((other) => (
            <BookPreview
                label={other.coverLabel}
                coverLabel={other.coverLabel}
                title={other.title}
                subtitle={other.subtitle}
                coverImageUrl={other.coverImageUrl}
                coverImageAlt={other.coverImageAlt}
                description={other.excerpt}
                cta={{ text: 'Learn More', link: `/books/${other.slug}` }}
            />
        ))}
    </main>
</SiteLayout>

<style lang="scss">
    @use '@tokens/mixins' as *;

    .book-hero {
        @include on-dark;
        margin-top: var(--header-height);
        background: var(--overlay-author), var(--color-surface-dark);
        color: var(--color-text-on-dark);

        &__inner {
            max-width: var(--container-book);
            margin: 0 auto;
            padding: var(--section-y) var(--gutter);
            display: grid;
            grid-template-columns: minmax(0, 20rem) minmax(0, 1fr);
            gap: var(--space-9);
            align-items: center;

            @media (max-width: $bp-md) {
                grid-template-columns: minmax(0, 1fr);
                gap: var(--space-7);
                @include centered;
            }
        }

        &__cover {
            display: flex;
            justify-content: center;

            @media (max-width: $bp-md) {
                max-width: 14rem;
                margin-inline: auto;
            }
        }

        &__text {
            display: flex;
            flex-direction: column;
            gap: var(--space-4);

            @media (max-width: $bp-md) {
                align-items: center;
            }
        }

        &__status {
            font-family: var(--font-ui);
            font-size: var(--text-xs);
            font-weight: var(--weight-semibold);
            letter-spacing: var(--tracking-wider);
            text-transform: uppercase;
            color: var(--gold);
        }

        &__title {
            font-size: var(--text-3xl);
            font-weight: var(--weight-extrabold);
            line-height: var(--leading-tight);
            text-wrap: balance;
        }

        &__subtitle {
            font-family: var(--font-quote);
            font-style: italic;
            font-size: var(--text-xl);
            color: var(--color-text-on-dark-secondary);
        }

        &__divider {
            width: var(--space-7);
            height: var(--border-rule);
            background: var(--gold);
        }

        &__excerpt {
            font-size: var(--text-md);
            line-height: var(--leading-relaxed);
            color: var(--color-text-on-dark-secondary);
        }

        &__actions {
            display: flex;
            flex-wrap: wrap;
            gap: var(--space-3);
            margin-top: var(--space-2);

            @media (max-width: $bp-md) {
                justify-content: center;
            }
        }
    }

    .book-about {
        background: var(--color-bg);

        &__inner {
            font-size: var(--text-prose);
            max-width: calc(var(--measure) + 2 * var(--gutter));
            margin: 0 auto;
            padding: var(--section-y) var(--gutter);

            // With details or previews: text column plus a sidebar
            &--sidebar {
                max-width: var(--container-book);
                display: grid;
                grid-template-columns: minmax(0, var(--measure)) minmax(0, 18rem);
                justify-content: space-between;
                gap: var(--space-8);

                @media (max-width: $bp-lg) {
                    grid-template-columns: minmax(0, 1fr);
                    max-width: calc(var(--measure) + 2 * var(--gutter));
                }
            }
        }

        &__heading {
            font-size: var(--text-2xl);
            font-weight: var(--weight-bold);
            color: var(--color-text-strong);
            line-height: var(--leading-tight);
            margin-bottom: var(--space-5);
        }

        &__sidebar {
            display: flex;
            flex-direction: column;
            gap: var(--space-6);
        }

        &__panel {
            display: flex;
            flex-direction: column;
            gap: var(--space-3);
        }

        &__panel-title {
            font-family: var(--font-display);
            font-size: var(--text-lg);
            font-weight: var(--weight-bold);
            color: var(--color-text-strong);
            padding-bottom: var(--space-2);
            border-bottom: var(--border-rule) solid var(--color-text-strong);
        }

        &__details {
            display: flex;
            flex-direction: column;
        }

        &__detail {
            display: grid;
            grid-template-columns: 7rem minmax(0, 1fr);
            gap: var(--space-3);
            padding-block: var(--space-3);
            border-bottom: var(--border-thin) solid var(--color-border);
            font-size: var(--text-base);

            dt {
                font-family: var(--font-ui);
                font-size: var(--text-xs);
                font-weight: var(--weight-semibold);
                letter-spacing: var(--tracking-wide);
                text-transform: uppercase;
                color: var(--color-text-secondary);
                padding-top: 0.2em;
            }

            dd {
                color: var(--color-text);
            }
        }

        &__previews {
            list-style: none;
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: var(--space-3);

            li {
                max-inline-size: none;
            }

            img,
            .book-about__preview-placeholder {
                width: 100%;
                aspect-ratio: 3 / 4;
                object-fit: cover;
                border: var(--border-thin) solid var(--color-border);
            }
        }

        &__preview-placeholder {
            display: flex;
            align-items: center;
            justify-content: center;
            padding: var(--space-3);
            text-align: center;
            font-family: var(--font-ui);
            font-size: var(--text-xs);
            font-weight: var(--weight-semibold);
            letter-spacing: var(--tracking-wide);
            text-transform: uppercase;
            color: var(--color-text-secondary);
            background: var(--color-surface);
        }
    }
</style>
