---
import SiteLayout from '@layouts/SiteLayout.astro'
import { getBook, getBooks } from '@lib/content'

export async function getStaticPaths() {
    const books = await getBooks()
    return books.map((book) => ({ params: { slug: book.slug } }))
}

const book = await getBook(Astro.params.slug)

if (!book) return Astro.redirect('/books')
---

<SiteLayout title={book.title} description={book.excerpt ?? ''}>
    <main id="main">
        <section class="book-detail">
            <div class="book-detail__container">
                <p>Book detail — coming soon</p>
            </div>
        </section>
    </main>
</SiteLayout>

<style lang="scss">
    .book-detail {
        background: var(--color-bg);
        min-height: 100vh;

        &__container {
            max-width: var(--container-book);
            margin: 0 auto;
            padding: var(--page-top) var(--gutter) var(--section-y);
        }
    }
</style>
