---
import BookView from '../../views/BookView.astro'
import { getBook, getBooks } from '@lib/content'

export async function getStaticPaths() {
    const books = await getBooks()
    return books.map((book) => ({ params: { slug: book.slug } }))
}

const book = await getBook(Astro.params.slug)
if (!book) return Astro.redirect('/books')
const otherBooks = (await getBooks()).filter((other) => other.slug !== book.slug)
---

<BookView book={book} otherBooks={otherBooks} />
