---
import ArticleView from '../../views/ArticleView.astro'
import { getArticle, getArticles, getRelatedArticles } from '@lib/content'

export async function getStaticPaths() {
    const articles = await getArticles()
    return articles.map((article) => ({ params: { slug: article.slug } }))
}

const article = await getArticle(Astro.params.slug)
if (!article) return Astro.redirect('/articles')
const related = await getRelatedArticles(article.slug)
---

<ArticleView article={article} related={related} />
