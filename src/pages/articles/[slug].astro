---
import SiteLayout from '@layouts/SiteLayout.astro'
import AboutPreview from '@components/sections/AboutPreview/AboutPreview.astro'
import ArticlesSection from '@components/sections/ArticlesSection/ArticlesSection.astro'
import RichText from '@components/base/RichText/RichText.astro'
import TableOfContents from '@components/composite/TableOfContents/TableOfContents'
import ReadingAids from '@components/composite/ReadingAids/ReadingAids'
import { getArticle, getArticles, getRelatedArticles, tableOfContents } from '@lib/content'
import { countWords } from '@lib/content/article-utils'

export async function getStaticPaths() {
    const articles = await getArticles()
    return articles.map((article) => ({ params: { slug: article.slug } }))
}

const article = await getArticle(Astro.params.slug)

if (!article) return Astro.redirect('/articles')

const related = await getRelatedArticles(article.slug)
const sources = article.sources ?? []
const toc = [
    ...tableOfContents(article.body),
    ...(sources.length ? [{ id: 'sources', text: 'Sources', level: 2 as const }] : []),
]
const words = countWords(article.body)
const tags = [article.category, ...(article.tags ?? [])].filter((tag, i, all) => tag && all.indexOf(tag) === i)

// The hero uses the article's image when there is one, otherwise its topic colours
const heroBackground = article.imageUrl
    ? `url("${article.imageUrl}")`
    : article.gradientFrom && article.gradientTo
        ? `linear-gradient(135deg, ${article.gradientFrom} 0%, ${article.gradientTo} 100%)`
        : 'var(--gradient-featured)'
---

<SiteLayout title={article.title} description={article.excerpt ?? ''}>
    <main id="main" class="article-detail">
        <header class="article-hero" style={`--hero-background: ${heroBackground}`}>
            <div class="article-hero__inner">
                <div class="article-hero__text">
                    <nav aria-label="Breadcrumb">
                        <ol class="article-hero__crumbs">
                            <li><a href="/">Home</a></li>
                            <li><a href="/articles">Articles</a></li>
                            {article.topicSlug && (
                                <li><a href={`/articles?topic=${article.topicSlug}`}>{article.category}</a></li>
                            )}
                        </ol>
                    </nav>

                    {tags.length > 0 && (
                        <ul class="article-hero__tags" aria-label="Topics">
                            {tags.map((tag) => <li>{tag}</li>)}
                        </ul>
                    )}

                    <h1 class="article-hero__title" id="article-title">{article.title}</h1>
                    {article.excerpt && <p class="article-hero__dek">{article.excerpt}</p>}

                    <p class="article-hero__meta">
                        {article.author && <span>By {article.author.name}</span>}
                        {article.readTime && <span>{article.readTime}</span>}
                        {words >= 200 && <span>{words.toLocaleString('en-US')} words</span>}
                    </p>
                </div>
            </div>
        </header>

        <div class="article-detail__layout">
            <aside class="article-detail__toc">
                <TableOfContents client:load items={toc} />
            </aside>

            <div class="article-detail__content">
                <div class="article-detail__body" id="article-body">
                    <RichText blocks={article.body} />
                </div>

                {sources.length > 0 && (
                    <details class="article-sources">
                        <summary class="article-sources__summary">
                            <h2 class="article-sources__title" id="sources">Sources &amp; Bibliography</h2>
                            <span class="article-sources__count">{sources.length} works</span>
                        </summary>
                        <ul class="article-sources__list">
                            {sources.map((source) => <li>{source}</li>)}
                        </ul>
                    </details>
                )}
            </div>
        </div>

        {article.author && (
            <AboutPreview
                name={article.author.name}
                role={article.author.role}
                bio={article.author.bio}
                imageUrl={article.author.imageUrl}
                initials={article.author.initials}
            />
        )}

        {related.length > 0 && (
            <ArticlesSection label="Continue Reading" heading="Related Articles" articles={related} />
        )}

        <ReadingAids client:load targetId="article-body" focusId="article-title" />
    </main>
</SiteLayout>

<style lang="scss">
    @use '@tokens/mixins' as *;

    // The text column is capped at the measure and centred on the page. From $bp-xl there is room for
    // the contents list in the left-hand column; below that it moves into a drawer.
    // font-size is set on the grid because ch in --measure resolves against the element's own font size
    @mixin article-grid {
        display: grid;
        grid-template-columns: minmax(0, var(--measure));
        justify-content: center;
        column-gap: var(--space-8);
        font-size: var(--text-prose);
        padding-inline: var(--gutter);

        @media (min-width: $bp-xl) {
            grid-template-columns: minmax(0, 1fr) minmax(0, var(--measure)) minmax(0, 1fr);
        }
    }

    .article-hero {
        @include on-dark;
        position: relative;
        margin-top: var(--header-height);
        background: var(--color-surface-dark);
        color: var(--color-text-on-dark);
        overflow: hidden;

        // Topic colours or the article image, darkened so white text keeps its contrast
        &::before,
        &::after {
            content: '';
            position: absolute;
            inset: 0;
        }

        &::before {
            background: var(--hero-background) center / cover no-repeat;
        }

        &::after {
            background: var(--overlay-author);
        }

        &__inner {
            @include article-grid;
            position: relative;
            z-index: 1;
            padding-block: var(--space-9) var(--space-8);
        }

        &__text {
            display: flex;
            flex-direction: column;
            gap: var(--space-4);

            @media (min-width: $bp-xl) {
                grid-column: 2;
            }
        }

        &__crumbs {
            list-style: none;
            display: flex;
            flex-wrap: wrap;
            gap: var(--space-2);
            font-family: var(--font-ui);
            font-size: var(--text-xs);
            letter-spacing: var(--tracking-wide);
            color: var(--color-text-on-dark-muted);

            li + li::before {
                content: '›';
                margin-right: var(--space-2);
            }

            a {
                color: var(--color-text-on-dark-secondary);
                text-decoration: underline;
                text-decoration-color: var(--color-hairline-on-dark);
                text-underline-offset: 0.2em;

                &:hover {
                    color: var(--color-text-on-dark);
                    text-decoration-color: currentColor;
                }
            }
        }

        &__tags {
            list-style: none;
            display: flex;
            flex-wrap: wrap;
            gap: var(--space-2);

            li {
                font-family: var(--font-ui);
                font-size: var(--text-xs);
                font-weight: var(--weight-semibold);
                letter-spacing: var(--tracking-wider);
                text-transform: uppercase;
                color: var(--gold);
                background: var(--gold-tint);
                border: var(--border-thin) solid var(--gold-border);
                padding: var(--space-1) var(--space-3);
            }
        }

        &__title {
            font-size: var(--text-3xl);
            font-weight: var(--weight-extrabold);
            line-height: var(--leading-tight);
            color: var(--color-text-on-dark);
            text-wrap: balance;
        }

        &__dek {
            font-size: var(--text-md);
            line-height: var(--leading-relaxed);
            color: var(--color-text-on-dark-secondary);
        }

        &__meta {
            display: flex;
            flex-wrap: wrap;
            gap: var(--space-2) var(--space-5);
            margin-top: var(--space-2);
            padding-top: var(--space-4);
            border-top: var(--border-thin) solid var(--color-hairline-on-dark);
            font-family: var(--font-ui);
            font-size: var(--text-sm);
            color: var(--color-text-on-dark-secondary);
            max-inline-size: none;

            span + span::before {
                content: '·';
                margin-right: var(--space-5);
                color: var(--color-text-on-dark-muted);
            }
        }
    }

    .article-detail {
        &__layout {
            @include article-grid;
            padding-block: var(--space-9) var(--section-y);
        }

        // Sits at the right edge of the left-hand column, just off the text
        &__toc {
            @media (max-width: calc($bp-xl - 1px)) {
                // The sidebar is hidden on smaller screens; the Contents button and drawer take over
                position: absolute;
            }

            @media (min-width: $bp-xl) {
                justify-self: end;
                width: min(15rem, 100%);
            }
        }

        &__content {
            min-width: 0;
        }

        // Headings land below the fixed header and reading-progress bar when jumped to
        :global(h2[id]),
        :global(h3[id]) {
            scroll-margin-top: calc(var(--header-height) + var(--space-6));
        }

        // The body is rendered by RichText, a child component, so Astro's scoped styles don't reach
        // its elements. :global() targets them, still limited to this page's .article-detail__body
        &__body {
            line-height: var(--leading-relaxed);
            color: var(--color-text);

            > :global(:first-child) { margin-top: 0; }

            :global(p) { margin-bottom: var(--space-5); }

            // ::first-letter keeps the word whole for screen readers, unlike a wrapping span
            > :global(p:first-of-type::first-letter) {
                float: left;
                font-family: var(--font-display);
                font-size: var(--text-display);
                font-weight: var(--weight-bold);
                color: var(--color-accent);
                line-height: 0.75;
                margin-right: var(--space-2);
                margin-top: var(--space-2);
            }

            :global(h2) {
                font-size: var(--text-xl);
                font-weight: var(--weight-bold);
                color: var(--color-text-strong);
                line-height: var(--leading-tight);
                margin: var(--space-8) 0 var(--space-4);
            }

            :global(h3) {
                font-size: var(--text-lg);
                font-weight: var(--weight-bold);
                color: var(--color-text-strong);
                line-height: var(--leading-tight);
                margin: var(--space-6) 0 var(--space-3);
            }

            :global(blockquote) {
                border-left: var(--border-rule) solid var(--color-accent);
                padding-left: var(--space-5);
                margin: var(--space-6) 0;
            }

            :global(blockquote p) {
                font-family: var(--font-quote);
                font-style: italic;
                font-size: var(--text-lg);
                line-height: var(--leading-normal);
                color: var(--color-text-strong);
                margin-bottom: var(--space-2);
            }

            :global(cite) {
                font-family: var(--font-ui);
                font-style: normal;
                font-size: var(--text-xs);
                font-weight: var(--weight-semibold);
                letter-spacing: var(--tracking-wide);
                text-transform: uppercase;
                color: var(--color-text-secondary);
            }
        }
    }

    .article-sources {
        margin-top: var(--space-8);
        border-top: var(--border-thin) solid var(--color-border);
        border-bottom: var(--border-thin) solid var(--color-border);

        &__summary {
            display: flex;
            align-items: baseline;
            flex-wrap: wrap;
            gap: var(--space-2) var(--space-4);
            padding-block: var(--space-5);
            cursor: pointer;
            list-style: none;

            &::-webkit-details-marker {
                display: none;
            }

            // A plus that turns into a minus when open
            &::after {
                content: '+';
                margin-left: auto;
                font-family: var(--font-ui);
                font-size: var(--text-xl);
                line-height: 1;
                color: var(--color-accent);
            }
        }

        &[open] &__summary::after {
            content: '−';
        }

        &__title {
            font-size: var(--text-xl);
            font-weight: var(--weight-bold);
            line-height: var(--leading-tight);
            color: var(--color-text-strong);
        }

        &__count {
            font-family: var(--font-ui);
            font-size: var(--text-sm);
            color: var(--color-text-secondary);
        }

        &__list {
            list-style: none;
            display: flex;
            flex-direction: column;
            gap: var(--space-3);
            padding-bottom: var(--space-6);
            font-size: var(--text-base);
            line-height: var(--leading-normal);
            color: var(--color-text-secondary);

            li {
                padding-left: var(--space-5);
                text-indent: calc(-1 * var(--space-5));
            }
        }
    }
</style>
