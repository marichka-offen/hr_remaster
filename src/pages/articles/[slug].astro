---
import SiteLayout from '@layouts/SiteLayout.astro'
import AboutPreview from '@components/sections/AboutPreview/AboutPreview.astro'
import PlaceholderImage from '@components/base/PlaceholderImage/PlaceholderImage'
import CategoryChip from '@components/base/CategoryChip/CategoryChip'
import ArticleMeta from '@components/base/ArticleMeta/ArticleMeta'
import RichText from '@components/base/RichText/RichText.astro'
import { getArticle, getArticles } from '@lib/content'

export async function getStaticPaths() {
    const articles = await getArticles()
    return articles.map((article) => ({ params: { slug: article.slug } }))
}

const article = await getArticle(Astro.params.slug)

if (!article) return Astro.redirect('/articles')

const gradient = article.gradientFrom && article.gradientTo
    ? `linear-gradient(135deg, ${article.gradientFrom} 0%, ${article.gradientTo} 100%)`
    : 'var(--gradient-featured)'
---

<SiteLayout title={article.title} description={article.excerpt ?? ''}>
    <main id="main" class="article-detail">
        <div class="article-detail__hero">
            {article.imageUrl ? (
                <img src={article.imageUrl} alt={article.imageAlt ?? article.title} class="article-detail__hero-img" />
            ) : (
                <PlaceholderImage gradient={gradient} code={article.period ?? ''} aspect="landscape" />
            )}
            <div class="article-detail__hero-overlay">
                <CategoryChip label={article.category} variant="overlay" />
            </div>
        </div>

        <div class="article-detail__container">
            <header class="article-detail__header">
                {article.subtitle && <p class="article-detail__subtitle">{article.subtitle}</p>}
                <h1 class="article-detail__title">{article.title}</h1>
                <ArticleMeta readTime={article.readTime} tag={article.tags?.[0]} tone="light" />
            </header>

            <div class="article-detail__body">
                <RichText blocks={article.body} />
            </div>
        </div>

        {article.author && (
            <AboutPreview
                name={article.author.name}
                role={article.author.role}
                bio={article.author.bio}
                imageUrl={article.author.imageUrl}
                initials={article.author.initials}
            />
        )}
    </main>
</SiteLayout>

<style lang="scss">
    @use '@tokens/mixins' as *;

    .article-detail {
        &__hero {
            position: relative;
            height: 480px;
            overflow: hidden;
            margin-top: var(--header-height);

            @media (max-width: $bp-md) {
                height: 280px;
            }
        }

        &__hero-img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        &__hero-overlay {
            position: absolute;
            top: var(--space-5);
            left: var(--space-5);
        }

        // The whole column follows the prose measure, so headings and paragraphs share one edge.
        // font-size is set here because ch resolves against the element's own font and size
        &__container {
            font-size: var(--text-prose);
            max-width: calc(var(--measure) + 2 * var(--gutter));
            margin: 0 auto;
            padding: var(--space-9) var(--gutter) var(--section-y);
        }

        &__header {
            margin-bottom: var(--space-8);
            padding-bottom: var(--space-6);
            border-bottom: var(--border-thin) solid var(--color-border);
        }

        &__subtitle {
            font-family: var(--font-ui);
            font-size: var(--text-xs);
            letter-spacing: var(--tracking-widest);
            text-transform: uppercase;
            color: var(--color-accent);
            font-weight: var(--weight-semibold);
            margin-bottom: var(--space-4);
        }

        &__title {
            font-size: var(--text-3xl);
            font-weight: var(--weight-extrabold);
            color: var(--color-text-strong);
            line-height: var(--leading-tight);
            margin-bottom: var(--space-5);
        }

        // The body is rendered by RichText, a child component, so Astro's scoped styles don't reach
        // its elements. :global() targets them, still limited to this page's .article-detail__body
        &__body {
            line-height: var(--leading-relaxed);
            color: var(--color-text);

            > :global(:first-child) { margin-top: 0; }

            :global(p) { margin-bottom: var(--space-5); }

            // ::first-letter keeps the word whole for screen readers, unlike a wrapping span
            > :global(p:first-of-type::first-letter) {
                float: left;
                font-family: var(--font-display);
                font-size: var(--text-display);
                font-weight: var(--weight-bold);
                color: var(--color-accent);
                line-height: 0.75;
                margin-right: var(--space-2);
                margin-top: var(--space-2);
            }

            :global(h2) {
                font-size: var(--text-xl);
                font-weight: var(--weight-bold);
                color: var(--color-text-strong);
                line-height: var(--leading-tight);
                margin: var(--space-8) 0 var(--space-4);
            }

            :global(h3) {
                font-size: var(--text-lg);
                font-weight: var(--weight-bold);
                color: var(--color-text-strong);
                line-height: var(--leading-tight);
                margin: var(--space-6) 0 var(--space-3);
            }

            :global(blockquote) {
                border-left: var(--border-rule) solid var(--color-accent);
                padding-left: var(--space-5);
                margin: var(--space-6) 0;
            }

            :global(blockquote p) {
                font-family: var(--font-quote);
                font-style: italic;
                font-size: var(--text-lg);
                line-height: var(--leading-normal);
                color: var(--color-text-strong);
                margin-bottom: var(--space-2);
            }

            :global(cite) {
                font-family: var(--font-ui);
                font-style: normal;
                font-size: var(--text-xs);
                font-weight: var(--weight-semibold);
                letter-spacing: var(--tracking-wide);
                text-transform: uppercase;
                color: var(--color-text-secondary);
            }
        }
    }
</style>
