---
import SiteLayout from '@layouts/SiteLayout.astro'
import PageSections from '@components/sections/PageSections/PageSections.astro'
import BookCard from '@components/composite/BookCard/BookCard'
import SectionHeader from '@components/composite/SectionHeader/SectionHeader.astro'
import { getBooks, getPage } from '@lib/content'

const [pageData, books] = await Promise.all([getPage('booksPage'), getBooks()])

const sections = pageData?.sections ?? []
const pageTitle = pageData?.title ?? 'Books'
const pageDescription = pageData?.description ?? ''
---

<SiteLayout title={pageTitle} description={pageDescription}>
    <main id="main">
        <PageSections sections={sections} />
        <section class="books-page">
            <div class="books-page__container">
                {sections.length === 0 && (
                    <div class="books-page__header">
                        <SectionHeader label="The Library" heading="Books" align="center" as="h1" />
                    </div>
                )}
                {books.length > 0 ? (
                    <div class="books-page__grid">
                        {books.map((book) => (
                            <BookCard book={book} />
                        ))}
                    </div>
                ) : (
                    <p class="books-page__empty">No books found.</p>
                )}
            </div>
        </section>
    </main>
</SiteLayout>

<style lang="scss">
    @use '@tokens/mixins' as *;

    .books-page {
        background: var(--parchment);

        &__container {
            max-width: var(--container-lg);
            margin: 0 auto;
            padding: var(--page-top) var(--gutter) var(--section-y);
        }

        &__header {
            margin-bottom: var(--space-8);
        }

        &__grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: var(--space-5);

            @media (max-width: $bp-lg) {
                grid-template-columns: repeat(3, 1fr);
            }

            @media (max-width: $bp-md) {
                grid-template-columns: repeat(2, 1fr);
                gap: var(--space-4);
            }

            @media (max-width: $bp-sm) {
                grid-template-columns: 1fr;
                max-width: 320px;
                margin-inline: auto;
            }
        }

        &__empty {
            font-family: var(--font-quote);
            font-style: italic;
            color: var(--text-muted);
            text-align: center;
            padding: var(--space-10) 0;
        }
    }
</style>
