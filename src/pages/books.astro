---
import SiteLayout from '@layouts/SiteLayout.astro'
import PageSections from '@components/sections/PageSections/PageSections.astro'
import BookCard from '@components/composite/BookCard/BookCard'
import SectionHeader from '@components/composite/SectionHeader/SectionHeader.astro'
import { sanityClient } from '@lib/sanity/client'
import { booksPageQuery, allBooksQuery } from '@lib/sanity/queries'

const [pageData, books] = await Promise.all([
    sanityClient.fetch(booksPageQuery).catch(() => null),
    sanityClient.fetch(allBooksQuery).catch(() => []),
])

const sections = pageData?.sections ?? []
const pageTitle = pageData?.title ?? 'Books'
const pageDescription = pageData?.description ?? ''
---

<SiteLayout title={pageTitle} description={pageDescription}>
    <main id="main">
        <PageSections sections={sections} />
        <section class="books-page">
            <div class="books-page__container">
                {sections.length === 0 && (
                    <div class="books-page__header">
                        <SectionHeader label="The Library" heading="Books" align="center" />
                    </div>
                )}
                {books.length > 0 ? (
                    <div class="books-page__grid">
                        {books.map((book: any) => (
                            <BookCard book={book} />
                        ))}
                    </div>
                ) : (
                    <p class="books-page__empty">No books found.</p>
                )}
            </div>
        </section>
    </main>
</SiteLayout>

<style lang="scss">
    .books-page {
        background: var(--parchment);

        &__container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 120px 24px 80px;

            @media (max-width: 768px) {
                padding: 80px 20px 56px;
            }
        }

        &__header {
            margin-bottom: 56px;
        }

        &__grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 24px;

            @media (max-width: 1024px) {
                grid-template-columns: repeat(3, 1fr);
            }

            @media (max-width: 768px) {
                grid-template-columns: repeat(2, 1fr);
                gap: 16px;
            }

            @media (max-width: 480px) {
                grid-template-columns: 1fr;
                max-width: 320px;
                margin-inline: auto;
            }
        }

        &__empty {
            font-family: var(--primary-font);
            font-style: italic;
            color: var(--text-muted);
            text-align: center;
            padding: 80px 0;
        }
    }
</style>
