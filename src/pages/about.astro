---
import SiteLayout from '@layouts/SiteLayout.astro'
import PageSections from '@components/sections/PageSections/PageSections.astro'
import { getPage } from '@lib/content'
import { authorSchema } from '@lib/seo'

const pageData = await getPage('about')

const sections = pageData?.sections ?? []
const pageTitle = pageData?.title ?? 'About'
const pageDescription = pageData?.description ?? ''
---

<SiteLayout title={pageTitle} description={pageDescription} jsonLd={authorSchema(Astro.site)}>
    <main id="main">
        <PageSections sections={sections} />
    </main>
</SiteLayout>
