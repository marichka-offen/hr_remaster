---
import BaseLayout from '@layouts/BaseLayout.astro'
import Header from '@components/sections/Header/Header.astro'
import Footer from '@components/sections/Footer/Footer.astro'
import { getSiteSettings } from '@lib/content'
import type { ComponentProps } from 'astro/types'

// Same options as BaseLayout (title, description, social image, structured data...), passed straight through
type Props = ComponentProps<typeof BaseLayout>

const { header, footer } = await getSiteSettings()
---

<BaseLayout {...Astro.props}>
    <Header
        logoTitle={header.logoTitle}
        logoSubtitle={header.logoSubtitle}
        navLinks={header.navigation ?? []}
    />
    <slot />
    <Footer
        logoTitle={header.logoTitle}
        logoSubtitle={header.logoSubtitle}
        navLinks={header.navigation ?? []}
        description={footer.description}
        topicsTitle={footer.topicsTitle}
        topics={footer.topics ?? []}
        copyright={footer.copyright}
        copyrightNote={footer.copyrightNote}
    />
</BaseLayout>
